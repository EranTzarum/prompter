{
  "permissions": {
    "allow": [
      "Bash(codex --version)",
      "Bash(codex --help)",
      "Bash(codex exec --help)",
      "Bash(codex features list)",
      "Bash(codex debug models)",
      "Bash(codex debug models > .scratch/models/*)",
      "Bash(codex exec --skip-git-repo-check --ignore-user-config --sandbox read-only -m *)",
      "Bash(claude --version)",
      "Bash(claude -p --strict-mcp-config --output-format json --model *)",
      "Bash(py -3 .scratch/models/*)",
      "Bash(py -3 tests/run_tests.py)",
      "Bash(py -3 tests/run_tests.py *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current)",
      "Bash(git add bin/*)",
      "Bash(git add skills/*)",
      "Bash(git add docs/*)",
      "Bash(git add CLAUDE.md)",
      "Bash(git add FACTORY_ARCHITECTURE.md)",
      "Bash(git commit -m *)",
      "Bash(git commit -F *)",
      "Bash(git push origin feat/model-catalog)",
      "Bash(git push -u origin feat/model-catalog)"
    ]
  }
}
